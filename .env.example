# ============================================
# Supabase
# ============================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# ============================================
# AI
# 优先级：sensenova（国内） → anthropic → openai
# ============================================
SENSENOVA_API_KEY=
SENSENOVA_BASE_URL=https://token.sensenova.cn/v1
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ============================================
# Inngest
# ============================================
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
INNGEST_DEV=true

# ============================================
# 国内支付 - 虎皮椒 (hupijiao.com)
# 个人可接入：微信支付 + 支付宝
# ============================================
HUPIJIAO_APP_ID=
HUPIJIAO_APP_SECRET=
HUPIJIAO_NOTIFY_URL=https://your-domain.com/api/payments/hupijiao/webhook

# ============================================
# 国内支付 - YunGouOS (yungouos.com) 备用
# ============================================
YUNGOUOS_MCH_ID=
YUNGOUOS_API_KEY=
YUNGOUOS_NOTIFY_URL=https://your-domain.com/api/payments/yungouos/webhook

# ============================================
# 海外支付 - Creem.io
# 个人可接入（Merchant of Record 模式）
# ============================================
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
# 6 模块 × 2 档（基础/深度）= 12 个 SKU
CREEM_PRODUCT_ID_TAROT_BASIC=
CREEM_PRODUCT_ID_TAROT_DEEP=
CREEM_PRODUCT_ID_ASTROLOGY_BASIC=
CREEM_PRODUCT_ID_ASTROLOGY_DEEP=
CREEM_PRODUCT_ID_BAZI_BASIC=
CREEM_PRODUCT_ID_BAZI_DEEP=
CREEM_PRODUCT_ID_DREAM_BASIC=
CREEM_PRODUCT_ID_DREAM_DEEP=
CREEM_PRODUCT_ID_YIJING_BASIC=
CREEM_PRODUCT_ID_YIJING_DEEP=
CREEM_PRODUCT_ID_BIRTHCHART_BASIC=
CREEM_PRODUCT_ID_BIRTHCHART_DEEP=

# ============================================
# Admin 入口
# ============================================
# 用于保护 /admin 路由（无 Supabase Auth）
ADMIN_TOKEN=

# ============================================
# 通用
# ============================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
PAYMENT_PRIMARY=hupijiao